<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Ashes.Registry</AssemblyName>
    <RootNamespace>Ashes.Registry</RootNamespace>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The registry is not part of the compiler's published artifacts; it deploys on its own. -->
    <IsPackable>false</IsPackable>
    <RegistryWebRoot>$(MSBuildProjectDirectory)/Web</RegistryWebRoot>
    <BuildRegistryWeb Condition="'$(BuildRegistryWeb)' == ''">true</BuildRegistryWeb>
  </PropertyGroup>

  <ItemGroup>
    <!-- Consumed as a library for publish-time validation (namespace lint, capability extraction);
         strictly one-way — no compiler phase depends on the registry (PACKAGE_MANAGER 12.1). -->
    <ProjectReference Include="..\Ashes.Frontend\Ashes.Frontend.csproj" />
    <ProjectReference Include="..\Ashes.Semantics\Ashes.Semantics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.10" />

    <!-- Pin patched versions of vulnerable transitive dependencies (NU1903 gate).
         Microsoft.OpenApi 2.0.0 (via AspNetCore.OpenApi) is patched at 2.7.5 (GHSA-v5pm-xwqc-g5wc);
         SQLitePCLRaw (via EF Core Sqlite) is only fixed in the 3.x line (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.10.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <RegistryWebSource Include="$(RegistryWebRoot)/src/**/*;$(RegistryWebRoot)/index.html;$(RegistryWebRoot)/package.json;$(RegistryWebRoot)/pnpm-lock.yaml;$(RegistryWebRoot)/pnpm-workspace.yaml;$(RegistryWebRoot)/tsconfig.json;$(RegistryWebRoot)/vite.config.ts" />
  </ItemGroup>

  <Target Name="BuildRegistryWeb"
          BeforeTargets="Build"
          Condition="'$(BuildRegistryWeb)' == 'true' and '$(DesignTimeBuild)' != 'true'"
          Inputs="@(RegistryWebSource)"
          Outputs="$(RegistryWebRoot)/dist/index.html">
    <Exec WorkingDirectory="$(RegistryWebRoot)" Command="pnpm install --frozen-lockfile --prefer-offline" />
    <Exec WorkingDirectory="$(RegistryWebRoot)" Command="pnpm run build" />
  </Target>

  <Target Name="PublishRegistryWeb"
          AfterTargets="ComputeFilesToPublish"
          Condition="'$(BuildRegistryWeb)' == 'true'">
    <ItemGroup>
      <RegistryWebDist Include="$(RegistryWebRoot)/dist/**/*" />
      <ResolvedFileToPublish Include="@(RegistryWebDist->'%(FullPath)')">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
