let recursive pieces (marker: Bytes) (items: List(Bytes)) (acc: List(Bytes)) =
    match items with
        | [] -> acc
        | payload :: rest -> pieces(marker)(rest)(marker :: acc)

let recursive fresh (n: Int) (acc: List(Bytes)) =
    if n == 0
    then acc
    else fresh(n - 1)(Ashes.Byte.allocate(n) :: acc)

let recursive count (xs: List(Bytes)) (total: Int) =
    match xs with
        | [] -> total
        | x :: rest -> count(rest)(total + Ashes.Byte.length(x))

let source = [Ashes.Byte.allocate(1), Ashes.Byte.allocate(2), Ashes.Byte.allocate(3)]

count(pieces(Ashes.Byte.allocate(7))(source)([]))(count(fresh(3)([]))(0)) |> Ashes.IO.print
