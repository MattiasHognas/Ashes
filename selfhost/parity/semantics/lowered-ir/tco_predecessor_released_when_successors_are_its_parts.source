// A loop threads the parts of a helper's owned pair as its successors. Each call's pair goes to an
// owned slot, and the pair the previous iteration left there moves to a predecessor slot. The
// successors are pattern bindings of the newer pair, parts of a value holding its own references,
// so none of them can still name the earlier pair, and the back edge releases it.
type Seen =
    | Leaf
    | Node(Seen, Str, Seen)

let recursive insert (key: Str) (seen: Seen) =
    match seen with
        | Leaf -> Node(Leaf, key, Leaf)
        | Node(left, current, right) -> Node(insert(key)(left), current, right)

let rootLength (seen: Seen) =
    match seen with
        | Leaf -> 0
        | Node(_left, current, _right) -> Ashes.Text.byteLength(current)

let recursive countItems (values: List(Str)) (total: Int) =
    match values with
        | [] -> total
        | _ :: rest -> countItems(rest)(total + 1)

let enqueue (key: Str) (back: List(Str)) (seen: Seen) = (key :: back, insert(key)(seen))

let recursive solve (front: List(Str)) (back: List(Str)) (seen: Seen) =
    match front with
        | [] -> rootLength(seen) + countItems(back)(0)
        | key :: rest ->
            match enqueue(key)(back)(seen) with
                | (nextBack, nextSeen) -> solve(rest)(nextBack)(nextSeen)

Ashes.IO.print(solve(["a", "b", "c", "d"])([])(Leaf))
