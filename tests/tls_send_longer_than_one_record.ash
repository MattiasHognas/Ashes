// tls-server: accept
// skip-on: win-x64
// The loopback TLS fixture is unsupported under the local Wine smoke-test; win-x64 TLS is covered
// by the native Windows CI runner. A text longer than one TLS record (16 KB) is written in more
// than one piece: the send keeps writing until the whole text is out.
// tls-expect: 
// tls-send: pong
// expect: 16500 pong
let recursive repeat (n: Int) (acc: Str) =
    if n == 0
    then acc
    else repeat(n - 1)(acc + "a")

let text = repeat(16500)("")

Ashes.IO.print(match (match await Ashes.Net.Tls.connect("localhost")(__TCP_PORT__) with
    | Error(err) -> err
    | Ok(sock) ->
        match await Ashes.Net.Tls.send(sock)(text) with
            | Error(err) -> err
            | Ok(sent) ->
                match await Ashes.Net.Tls.receive(sock)(64) with
                    | Error(err) -> err
                    | Ok(reply) ->
                        let _ = await Ashes.Net.Tls.close(sock)
                        in Ashes.Text.fromInt(sent) + " " + reply)
|> async
|> Ashes.Task.run with
    | Ok(result) -> result
    | Error(err) -> err)
