// A record a helper returns is let-bound and consed onto the spine the producer builds in place:
// the cell retains the binding's value for the transfer, and the binding's own reference is
// released with the iteration rather than counted as moved into the cell.
type Liveness =
    | block: Int
    | liveIn: Bool
    | liveOut: Bool

let make (b: Int) = Liveness(block = b, liveIn = true, liveOut = false)

let recursive step (remaining: List(Int)) =
    match remaining with
        | [] -> []
        | block :: rest ->
            let entry = make(block)
            in entry :: step(rest)

let recursive countLive (items: List(Liveness)) (total: Int) =
    match items with
        | [] -> total
        | Liveness { liveIn = true } :: rest -> countLive(rest)(total + 1)
        | _ :: rest -> countLive(rest)(total)

0
|> countLive(step([0, 1, 2, 3, 4]))
|> Ashes.IO.print
