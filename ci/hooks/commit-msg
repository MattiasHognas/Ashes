#!/usr/bin/env bash
# commit-msg — reject banned trailer lines in commit messages.
# Bans:  Co-Authored-By: and Claude-Session: trailers, the claude-projects-attribution
#        marker, a "Requested by **...**" line, and "Generated with Claude" footers.
# These must never enter the history. Bypass (discouraged): git commit --no-verify
set -euo pipefail

msg_file="$1"

# A real trailer starts the line with the keyword. Comment lines start with '#'
# (git strips those on cleanup) and are dropped before matching.
banned="$(grep -nEi 'claude-projects-attribution|^[[:space:]]*_?Requested by \*\*|^[[:space:]]*(Co-Authored-By|Claude-Session)[[:space:]]*:|Generated with \[Claude Code\]' "$msg_file" | grep -vE '^[0-9]+:[[:space:]]*#' || true)"

if [[ -n "$banned" ]]; then
  echo "commit-msg: rejected — remove banned trailer line(s):" >&2
  echo "$banned" | sed 's/^/  /' >&2
  echo "  (attribution trailers, markers and footers are not allowed in this repo)" >&2
  exit 1
fi

exit 0
