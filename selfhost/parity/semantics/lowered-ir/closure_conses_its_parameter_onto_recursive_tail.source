// A closure applied in a pipe conses its parameter onto the enclosing producer's recursive tail:
// the parameter reaches the result only as a list cell's head, so the entry does not normalize it
// into an owned copy the arena cell would keep nothing of.
type Liveness =
    | block: Int
    | liveIn: Bool
    | liveOut: Bool

let recursive step (remaining: List(Int)) =
    match remaining with
        | [] -> []
        | block :: rest ->
            Liveness(block = block, liveIn = true, liveOut = false) |> (given (entry) -> entry :: step(rest))

let recursive countLive (items: List(Liveness)) (total: Int) =
    match items with
        | [] -> total
        | Liveness { liveIn = true } :: rest -> countLive(rest)(total + 1)
        | _ :: rest -> countLive(rest)(total)

0
|> countLive(step([0, 1, 2, 3, 4]))
|> Ashes.IO.print
