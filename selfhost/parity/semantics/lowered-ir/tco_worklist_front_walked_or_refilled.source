// A worklist whose front queue is walked by its consumed tail and refilled from the reversed back
// queue: the front is placed on the reference-counted heap, taking the refill at the back edge and
// retaining the tail it walks on to.
let recursive reverseAll (values: List(Str)) (acc: List(Str)) =
    match values with
        | [] -> acc
        | value :: rest -> reverseAll(rest)(value :: acc)

let recursive solve (front: List(Str)) (back: List(Str)) (fuel: Int) =
    match front with
        | [] ->
            match back with
                | [] -> fuel
                | _ -> solve(reverseAll(back)([]))([])(fuel)
        | key :: rest ->
            if fuel <= 0
            then 0
            else solve(rest)(key + "x" :: back)(fuel - 1)

let recursive rounds (n: Int) (total: Int) =
    if n == 0
    then total
    else rounds(n - 1)(total + solve(["a", "b", "c"])([])(20))

0
|> rounds(10)
|> Ashes.IO.print
