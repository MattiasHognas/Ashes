<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Ashes.Tests</AssemblyName>
    <RootNamespace>Ashes.Tests</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableTestingPlatform>true</EnableTestingPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ashes.Frontend\Ashes.Frontend.csproj" />
    <ProjectReference Include="..\Ashes.Backend\Ashes.Backend.csproj" />
    <ProjectReference Include="..\Ashes.Dap\Ashes.Dap.csproj" />
    <ProjectReference Include="..\Ashes.Semantics\Ashes.Semantics.csproj" />
    <ProjectReference Include="..\Ashes.Lsp\Ashes.Lsp.csproj" />
    <ProjectReference Include="..\Ashes.TestRunner\Ashes.TestRunner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.58.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.2.3" />
    <PackageReference Include="Verify.TUnit" Version="31.20.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="BannedSymbols.txt" />
    <Content Include="Fixtures/affine_resource.c" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/ffi_buffer.c" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/ffi_foreign_buffer.c" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/ffi_out.c" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/ffi_string.c" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../selfhost/parity/frontend/tokens/*" Link="Fixtures/SelfhostTokenParity/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../selfhost/parity/semantics/lowered-ir/*" Link="Fixtures/SelfhostIrParity/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
