{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ashes",
  "scopeName": "source.ashes",
  "patterns": [
    { "include": "#comments" },
    { "include": "#imports" },
    { "include": "#traits" },
    { "include": "#ffi" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ashes",
          "match": "//.*$"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "match": "^\\s*(import)\\s+([A-Z][A-Za-z0-9_]*(?:\\.[A-Z][A-Za-z0-9_]*)*)(?:\\s+(as)\\s+([A-Za-z][A-Za-z0-9_]*))?\\s*$",
          "captures": {
            "1": { "name": "keyword.control.import.ashes" },
            "2": { "name": "entity.name.namespace.ashes" },
            "3": { "name": "keyword.control.as.ashes" },
            "4": { "name": "entity.name.namespace.alias.ashes" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ashes",
          "match": "(?<!\\w)(let\\?|let!)(?!\\w)"
        },
        {
          "name": "keyword.control.ashes",
          "match": "\\b(let|recursive|in|if|then|else|match|with|when|given|type|alias|module|await|external|capability|provide|needs|perform|handle)\\b"
        }
      ]
    },
    "ffi": {
      "patterns": [
        {
          "match": "\\b(resource)\\s+(destructor)\\b",
          "captures": {
            "1": { "name": "storage.modifier.resource.ashes" },
            "2": { "name": "storage.modifier.destructor.ashes" }
          }
        },
        {
          "name": "storage.modifier.ownership.ashes",
          "match": "\\b(borrow|consume|out)(?=\\s+(?:\\*|[A-Z]))"
        },
        {
          "begin": "\\b(FfiStr)(\\()",
          "beginCaptures": {
            "1": { "name": "support.type.ffi.ashes" },
            "2": { "name": "punctuation.paren.open.ashes" }
          },
          "end": "(\\))",
          "endCaptures": {
            "1": { "name": "punctuation.paren.close.ashes" }
          },
          "patterns": [
            {
              "name": "storage.modifier.ffi-string.ashes",
              "match": "\\b(nullable|owned|borrowed)\\b"
            },
            { "include": "#identifiers" }
          ]
        },
        {
          "name": "support.type.ffi.ashes",
          "match": "\\b(FfiBuffer|FfiStr)\\b"
        },
        {
          "name": "support.type.builtin.ashes",
          "match": "\\b(u8|u16|u32|u64|void)\\b"
        }
      ]
    },
    "traits": {
      "patterns": [
        {
          "match": "\\b(trait)\\s+([A-Z][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.declaration.trait.ashes" },
            "2": { "name": "entity.name.type.trait.ashes" }
          }
        },
        {
          "match": "\\b(implement)\\s+((?:[A-Z][A-Za-z0-9_]*\\.)*[A-Z][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.declaration.implement.ashes" },
            "2": { "name": "entity.other.inherited-class.trait.ashes" }
          }
        },
        {
          "begin": "\\b(requires)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.other.requires.ashes" },
            "2": { "name": "punctuation.section.braces.begin.ashes" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.braces.end.ashes" }
          },
          "patterns": [
            {
              "name": "entity.other.inherited-class.trait.ashes",
              "match": "(?:[A-Z][A-Za-z0-9_]*\\.)*[A-Z][A-Za-z0-9_]*(?=\\s*\\()"
            },
            { "include": "#punctuation" },
            { "include": "#identifiers" }
          ]
        },
        {
          "begin": "\\b(deriving)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.other.deriving.ashes" },
            "2": { "name": "punctuation.section.braces.begin.ashes" }
          },
          "end": "(\\})",
          "endCaptures": {
            "1": { "name": "punctuation.section.braces.end.ashes" }
          },
          "patterns": [
            {
              "name": "entity.other.inherited-class.trait.ashes",
              "match": "(?:[A-Z][A-Za-z0-9_]*\\.)*[A-Z][A-Za-z0-9_]*"
            },
            { "include": "#punctuation" }
          ]
        },
        {
          "match": "^\\s*(\\|)\\s*([a-z_][A-Za-z0-9_]*)\\s*(:|=)",
          "captures": {
            "1": { "name": "punctuation.definition.trait-method.ashes" },
            "2": { "name": "entity.name.function.trait-method.ashes" },
            "3": { "name": "keyword.operator.assignment.ashes" }
          }
        },
        {
          "match": "\\b((?:Ashes\\.Trait\\.)?(?:Eq|Ord|Show|Hash|Default|Add|Subtract|Multiply|Divide|Remainder|Negate|Not|BitAnd|BitOr|BitXor|ShiftLeft|ShiftRight|BitwiseNot))(\\.)(equal|notEqual|compare|less|lessOrEqual|greater|greaterOrEqual|show|hash|default|add|subtract|multiply|divide|remainder|negate|not|bitAnd|bitOr|bitXor|shiftLeft|shiftRight|bitwiseNot)\\b",
          "captures": {
            "1": { "name": "entity.name.type.trait.ashes" },
            "2": { "name": "punctuation.accessor.ashes" },
            "3": { "name": "entity.name.function.trait-method.ashes" }
          }
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.ashes",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.wildcard.ashes",
          "match": "(?<!\\w)_(?!\\w)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ashes",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ashes",
              "match": "\\\\[nrt\\\"\\\\]"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.ashes",
          "match": "\\b\\d+\\.\\d+"
        },
        {
          "name": "constant.numeric.integer.ashes",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.ashes",
          "match": "\\|\\?>|\\|!>|\\|>"
        },
        {
          "name": "keyword.operator.ashes",
          "match": "->|::|<<|>>|>=|<=|==|!=|\\+|\\-|\\*|\\/|%|&|\\^|~|!|>|<|=|\\||,|\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.paren.open.ashes",
          "match": "\\("
        },
        {
          "name": "punctuation.paren.close.ashes",
          "match": "\\)"
        },
        {
          "name": "punctuation.bracket.open.ashes",
          "match": "\\["
        },
        {
          "name": "punctuation.bracket.close.ashes",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.ashes",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.ashes",
          "match": "\\}"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.type.ashes",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "variable.other.ashes",
          "match": "\\b[a-z_][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
